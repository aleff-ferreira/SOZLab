{
  "version": "1.0",
  "inputs": {
    "topology": "examples/data/demo.gro",
    "trajectory": "examples/data/demo.xtc",
    "processed_trajectory": null,
    "preprocessing_notes": null
  },
  "solvent": {
    "solvent_label": "Water",
    "water_resnames": [
      "SOL"
    ],
    "water_oxygen_names": [
      "O",
      "OW",
      "OH2"
    ],
    "water_hydrogen_names": [
      "H1",
      "H2",
      "HW1",
      "HW2"
    ],
    "ion_resnames": [
      "NA",
      "CL",
      "K",
      "CA",
      "MG"
    ],
    "include_ions": false,
    "probe": {
      "selection": "name OW",
      "position": "atom"
    }
  },
  "selections": {
    "solute": {
      "label": "solute",
      "display_label": null,
      "selection": "resname LIG",
      "atom_indices": null,
      "pdb_serials": null,
      "resid": null,
      "resname": null,
      "atomname": null,
      "segid": null,
      "chain": null,
      "expect_count": null,
      "require_unique": false,
      "updating": false
    }
  },
  "sozs": [
    {
      "name": "first_shell",
      "description": "water oxygens within 3.5 A of the solute",
      "root": {
        "type": "distance",
        "params": {
          "selection_label": "solute",
          "cutoff": 3.5,
          "unit": "A"
        },
        "children": []
      }
    }
  ],
  "analysis": {
    "frame_start": 0,
    "frame_stop": null,
    "stride": 1,
    "gap_tolerance": 0,
    "workers": null,
    "store_ids": true,
    "store_min_distances": true,
    "preview_frames": 200,
    "dt_override": null,
    "gap_tolerance_time": null,
    "uncertainty_blocks": 5,
    "stride_sensitivity": true,
    "parallel_min_seconds": 10.0
  },
  "outputs": {
    "output_dir": "demo_results",
    "write_per_frame": true,
    "write_parquet": false,
    "report_format": "html"
  },
  "extraction": {
    "soz_name": null,
    "rule": "n_solvent>=1",
    "min_run_length": 1,
    "gap_tolerance": 0,
    "output_format": "xtc",
    "output_dir": "results/extracted"
  },
  "hbond_hydration": [],
  "density_maps": [],
  "water_dynamics": []
}